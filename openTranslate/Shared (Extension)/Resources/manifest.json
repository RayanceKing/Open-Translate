{
  "manifest_version": 3,
  "name": "Open Translate",
  "version": "1.0.0",
  "description": "Privacy-conscious in-place bilingual web translation with switchable engines and AI translation.",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Translate",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "images/icon-48.png",
      "96": "images/icon-96.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "toggle-translation": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "翻译或还原当前页面"
    }
  }
}
